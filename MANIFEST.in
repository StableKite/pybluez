include CHANGELOG
include COPYING
include README
include setup.py

recursive-include bluetooth *.py

recursive-include bluez *.c
recursive-include bluez *.h
recursive-include msbt *.c
recursive-include macos *.c
recursive-include macos *.h

recursive-include examples *.py

recursive-exclude * *.pyc
recursive-exclude * *.o
recursive-exclude * *.opp

# Include the PEP 517 delivery adapter in source distributions.
include _binary_wheel_backend.py binary_wheels.json README.binary-wheels.md
